# Copy this file to .env and fill in the values. Never commit .env.

# AI model
ANTHROPIC_API_KEY=

# Supabase database (use the secret key, not the publishable one)
SUPABASE_URL=
SUPABASE_KEY=

# Gmail API (paths to the login files)
GMAIL_CREDENTIALS_PATH=credentials/credentials.json
GMAIL_TOKEN_PATH=credentials/token.json

# Only for a hosted server: the whole content of credentials/token.json as one value.
# Leave it out on your own computer.
# GMAIL_TOKEN_JSON=

# Password for the review dashboard. Choose a long one. Without it nobody can log in.
DASHBOARD_PASSWORD=

# Optional: set to true once the site is served over https.
# COOKIE_SECURE=false

# Optional: how often to check Gmail, in seconds. 0 turns checking off.
# POLL_INTERVAL_SECONDS=60
